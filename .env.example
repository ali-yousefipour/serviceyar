APP_NAME=ServiceYar
APP_ENV=local
APP_DEBUG=false
APP_SECURE_COOKIE=0
APP_URL=http://localhost:8080

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=challi_ali
DB_USERNAME=challi_ali
DB_PASSWORD= # Set the production password in the hosting .env; never commit it

SESSION_COOKIE=serviceyar_session
SESSION_LIFETIME=604800

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Negin / AlmasSms fallback values. Super Admin can manage encrypted credentials in Settings.
# Database credentials take precedence over these environment fallbacks.
NEGIN_SMS_ENABLED=0
NEGIN_SMS_USERNAME=
NEGIN_SMS_PASSWORD=

# Bale authentication/messaging bot (independent from wallet payments).
# Set APP_URL to the public HTTPS origin, e.g. https://challi.ir
# Keep this key stable after saving the encrypted bot token.
# Use a unique random secret of 32+ characters (never commit real values).
BALE_SETTINGS_KEY=

# Bale wallet bot. Register a webhook using a random secret of at least 32 chars.
BALE_PAYMENTS_ENABLED=0
BALE_BOT_TOKEN=
BALE_WALLET_PROVIDER_TOKEN=
BALE_WEBHOOK_SECRET=

# Google Routes server key. OSM is used for the interactive base map.
GOOGLE_MAPS_SERVER_KEY=
