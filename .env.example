APP_NAME=ServiceYar
APP_ENV=local
APP_DEBUG=false
APP_SECURE_COOKIE=0
APP_URL=http://localhost:8080

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=challi_ali
DB_USERNAME=challi_ali
DB_PASSWORD= # Set the production password in the hosting .env; never commit it

SESSION_COOKIE=serviceyar_session
SESSION_LIFETIME=604800

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Negin / AlmasSms. Values are server-only. Enable after staging verification.
NEGIN_SMS_ENABLED=0
NEGIN_SMS_USERNAME=
NEGIN_SMS_PASSWORD=

# Bale wallet bot. Register a webhook using a random secret of at least 32 chars.
BALE_PAYMENTS_ENABLED=0
BALE_BOT_TOKEN=
BALE_WALLET_PROVIDER_TOKEN=
BALE_WEBHOOK_SECRET=

# Google Routes server key. OSM is used for the interactive base map.
GOOGLE_MAPS_SERVER_KEY=
